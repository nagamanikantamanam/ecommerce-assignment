{
  "name": "api-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "dev": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --watch",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js",
    "start":  "nodemon --ext ts --exec \"node --loader ts-node/esm src/index.ts\""

  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "esbuild": "^0.19.5",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}